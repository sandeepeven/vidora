{
  "expo": {
    "name": "LowTube",
    "slug": "vidora",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0f0f",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f0f0f"
    },
    "android": {
      "package": "com.sandeep.vidora",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LowTube reads the videos on your phone so you can watch them offline.",
          "savePhotosPermission": "LowTube does not save media.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e7e50692-0176-42c9-8075-c83fa2dc7413"
      }
    }
  }
}
